{
  "_readme": "ПРИМЕР ДЛЯ ЧТЕНИЯ. Рабочий конфиг рендерит install-server.sh из server.env на VPS. Все значения-плейсхолдеры REPLACE_WITH_* заменяются при рендере — руками этот файл не правится и в реальные конфиги не копируется.",

  "log": { "level": "warn", "timestamp": true },

  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-reality-t1",
      "listen": "::",
      "listen_port": 443,
      "users": [ { "name": "sovereign", "uuid": "REPLACE_WITH_UUID", "flow": "xtls-rprx-vision" } ],
      "tls": {
        "enabled": true,
        "server_name": "www.microsoft.com",
        "reality": {
          "enabled": true,
          "handshake": { "server": "www.microsoft.com", "server_port": 443 },
          "private_key": "REPLACE_WITH_REALITY_PRIVATE_KEY",
          "short_id": [ "REPLACE_WITH_SHORT_ID" ]
        }
      }
    },
    {
      "type": "vless",
      "tag": "vless-ws-t2",
      "listen": "::",
      "listen_port": 8443,
      "users": [ { "name": "sovereign", "uuid": "REPLACE_WITH_UUID" } ],
      "tls": {
        "enabled": true,
        "server_name": "edge.example.com",
        "certificate_path": "/etc/sovereign-node/cert.pem",
        "key_path": "/etc/sovereign-node/key.pem"
      },
      "transport": { "type": "ws", "path": "/REPLACE_WITH_T2_PATH" }
    },
    {
      "type": "hysteria2",
      "tag": "hy2-t3",
      "listen": "::",
      "listen_port": 443,
      "up_mbps": 200,
      "down_mbps": 200,
      "users": [ { "name": "sovereign", "password": "REPLACE_WITH_HY2_PASSWORD" } ],
      "obfs": { "type": "salamander", "password": "REPLACE_WITH_HY2_OBFS" },
      "tls": {
        "enabled": true,
        "alpn": ["h3"],
        "certificate_path": "/etc/sovereign-node/cert.pem",
        "key_path": "/etc/sovereign-node/key.pem"
      },
      "masquerade": "https://www.microsoft.com/"
    }
  ],

  "outbounds": [ { "type": "direct", "tag": "direct" } ]
}
