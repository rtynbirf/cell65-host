# node.env.example — структура файла правды. Скопируй в node.env и заполни.
# РЕАЛЬНЫЕ значения в этот файл НЕ попадают (он не пушится в репозиторий).
VPS_IP=
VPS_IPV6=
DOMAIN=
CF_ACCOUNT_ID=SET_ME_ACCOUNT_ID
CF_TOKEN=SET_ME_CF_TOKEN
VLESS_UUID=SET_ME_UUID
REALITY_PUBLIC_KEY=SET_ME_REALITY_PUBLIC_KEY
REALITY_SHORT_ID=SET_ME_SHORT_ID
HY2_PASSWORD=SET_ME_HY2_PASSWORD
HY2_OBFS=SET_ME_HY2_OBFS
SNI_MASK=www.microsoft.com
XHTTP_PATH=/xh
REALITY_PORT=443
XHTTP_PORT=8443
HY2_PORT=443
